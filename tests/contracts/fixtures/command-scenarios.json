{
  "scenarios": [
    {
      "id": "edit_undo_redo",
      "initial": {
        "project_instance_id": "session-a",
        "patch": "default",
        "revision": 0,
        "undo": [],
        "redo": []
      },
      "steps": [
        {
          "action": "apply",
          "command": {
            "schema_version": 1,
            "type": "replace_instrument_patch",
            "project_instance_id": "session-a",
            "expected_revision": 0,
            "patch": "soft_saw"
          },
          "expected": {
            "result": "applied",
            "project_instance_id": "session-a",
            "patch": "soft_saw",
            "revision": 1,
            "undo": [
              "default"
            ],
            "redo": []
          }
        },
        {
          "action": "undo",
          "expected": {
            "result": "applied",
            "project_instance_id": "session-a",
            "patch": "default",
            "revision": 2,
            "undo": [],
            "redo": [
              "soft_saw"
            ]
          }
        },
        {
          "action": "redo",
          "expected": {
            "result": "applied",
            "project_instance_id": "session-a",
            "patch": "soft_saw",
            "revision": 3,
            "undo": [
              "default"
            ],
            "redo": []
          }
        }
      ]
    },
